# Upstream Solana RPC endpoint (e.g. Triton, Helius, QuickNode, or local test validator)
SOLANA_UPSTREAM_RPC_URL=https://api.mainnet-beta.solana.com

# Local proxy listen host and port
PROXY_HOST=127.0.0.1
PROXY_PORT=8899

# Compute Unit safety buffer percentage (e.g. 15 for +15% headroom above simulated consumption)
CU_SAFETY_BUFFER_PERCENT=15

# Maximum Compute Units limit cap per transaction
MAX_CU_LIMIT=1400000

# Request timeout in milliseconds
RPC_TIMEOUT_MS=5000
